# Copy this file to .env and fill in your values (cp .env.example .env).
# Never commit .env to source control.

# ── Connection ────────────────────────────────────────────────────────────────
# URL of the Gravitee management API.
# If Gravitee is running in the same Docker network use the service name,
# e.g. http://gravitee-management-api:8083
GRAVITEE_BASE_URL=http://host.docker.internal:8083

# Organisation and environment IDs (leave as DEFAULT for single-org installs).
GRAVITEE_ORG_ID=DEFAULT
GRAVITEE_ENV_ID=DEFAULT

# ── Authentication ────────────────────────────────────────────────────────────
# Credentials are NOT configured here. Enter a personal access token, or a
# username and password, in the Connection page of the web interface (or when
# the command line asks for them). Any GRAVITEE_TOKEN, GRAVITEE_USERNAME or
# GRAVITEE_PASSWORD found in this file is ignored.

# ── SSL ───────────────────────────────────────────────────────────────────────
# Set to false only for self-signed certs in non-production environments.
GRAVITEE_VERIFY_SSL=false

# ── Tuning ────────────────────────────────────────────────────────────────────
GRAVITEE_RETRY_ATTEMPTS=3
GRAVITEE_RETRY_DELAY_S=2
GRAVITEE_PAGE_SIZE=100

# ── File paths (inside the container — usually no need to change) ─────────────
INPUT_CSV=/data/migration_input.csv
OUTPUT_CSV=/data/migration_results.csv
LOG_FILE=/data/gravitee_migration.log

# ── Web interface ─────────────────────────────────────────────────────────────
# Port on your machine where the UI is published (docker compose).
UI_PORT=8080
